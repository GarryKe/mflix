<!-- Skeleton loader (initially hidden, appears when the page is loading) -->
<div class="item item-skeleton">
    <div class="item-image image-skeleton"></div>
    <div class="item-desc">
        <p class="name name-skeleton"></p>
        <p class="rating rating-skeleton"></p>
    </div>
</div>
<div class="item item-skeleton">
    <div class="item-image image-skeleton"></div>
    <div class="item-desc">
        <p class="name name-skeleton"></p>
        <p class="rating rating-skeleton"></p>
    </div>
</div>
<div class="item item-skeleton">
    <div class="item-image image-skeleton"></div>
    <div class="item-desc">
        <p class="name name-skeleton"></p>
        <p class="rating rating-skeleton"></p>
    </div>
</div>
<!-- Spinner (initially hidden, appears when more items are being loaded) -->
<div id="<%= category %>-hold" class="spinner-hold">
    <div class="ytp-spinner" data-layer="4">
        <div>
            <div class="ytp-spinner-container">
                <div class="ytp-spinner-rotator">
                    <div class="ytp-spinner-left">
                        <div class="ytp-spinner-circle"></div>
                    </div>
                    <div class="ytp-spinner-right">
                        <div class="ytp-spinner-circle"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>